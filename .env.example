# ============================================================
# NovelCraft 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ============================================================

# PostgreSQL 连接串（Supabase 事务池）
# 格式：postgresql://用户名:密码@主机:端口/数据库名?sslmode=require
DATABASE_URL=postgresql://postgres:password@host:port/dbname?sslmode=require

# ============================================================
# AI 模型提供商 API Key
# ============================================================

# 智谱 AI（默认提供商）
ZHIPU_API_KEY=your_zhipu_api_key_here

# 阿里云通义千问（可选）
DASHSCOPE_API_KEY=

# DeepSeek（可选）
DEEPSEEK_API_KEY=

# 月之暗面 Kimi（可选）
MOONSHOT_API_KEY=

# 字节豆包 / 火山方舟（可选）
ARK_API_KEY=

# ============================================================
# 加密密钥（用于加密自定义 API Key）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# ============================================================
# Auth.js 配置
# ============================================================
AUTH_SECRET=your_auth_secret_here

# ============================================================
# Passkey / WebAuthn 配置
# 部署后需要更新为生产域名
# ============================================================
WEBAUTHN_RP_NAME="NovelCraft"
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ============================================================
# 旧版兼容配置
# ============================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4-flash
